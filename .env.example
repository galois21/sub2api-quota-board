# Copy to /etc/sub2api-quota-board.env with mode 600.
# Set the administrator key on the server; never commit the real value.
SUB2API_BASE_URL=http://127.0.0.1:8080
SUB2API_ADMIN_KEY=
PUBLIC_ORIGIN=https://sub2api.example.com
BASE_PATH=/quota
PORT=18081
# Optional comma-separated HTTPS origins allowed to embed this page in an iframe.
# This changes only the CSP frame-ancestors policy; it does not grant API access.
ALLOWED_FRAME_ORIGINS=
